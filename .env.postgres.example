# Created as private .env.postgres by ./scripts/start.sh --postgres.
# Change GATE_PORT to select your dashboard + API port.
GATE_PORT=4310
GATE_BIND=127.0.0.1
GATE_IMAGE=gate-llm:local

# Generated automatically on first start; keep it stable across restarts.
# Changing this does not change the password in an initialized PostgreSQL volume.
POSTGRES_PASSWORD=
DATABASE_POOL_MAX=10
DATABASE_POOL_WAITING_MAX=100

COOKIE_SECURE=false
LOG_LEVEL=info
ALLOW_PRIVATE_UPSTREAMS=false
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
