# See README. Node 22.13+ is required. No provider secrets belong in this file.
HOST=127.0.0.1
PORT=4310
DATA_DIR=./data
# Set to true only behind HTTPS when sharing with your team.
COOKIE_SECURE=false
# Explicit opt-in for local Ollama/vLLM and private network endpoints.
ALLOW_PRIVATE_UPSTREAMS=false
# Defaults to allowing first-owner setup only from loopback.
ALLOW_REMOTE_SETUP=false
