# DOCKER COMPOSE — normally only change GATE_PORT.
# Start: ./scripts/start.sh     Open: http://localhost:4310
GATE_PORT=4310
GATE_BIND=127.0.0.1
# Source builds use a local tag, separate from published releases.
GATE_IMAGE=gate-llm:local

# SHARED OPTIONS — leave these defaults for local HTTP setup.
# Enable secure cookies when serving through an HTTPS reverse proxy.
COOKIE_SECURE=false
LOG_LEVEL=info
# Enable only for trusted private/Ollama/vLLM endpoints.
ALLOW_PRIVATE_UPSTREAMS=false

# OPTIONAL AWS CATALOG — leave blank when using an AWS runtime IAM role.
# For temporary credentials supply all three values; never commit this file.
# Configure bedrock:ListFoundationModels, bedrock:GetFoundationModelAvailability
# and bedrock:ListInferenceProfiles for the server identity.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# DIRECT NODE / npm / pip ONLY — Compose fixes its internal port and data path.
# These values are not passed into the container by compose.yaml.
HOST=127.0.0.1
PORT=4310
DATA_DIR=./data
ALLOW_REMOTE_SETUP=false

# PostgreSQL is not connected to the live gateway yet. Do not add DATABASE_URL
# expecting a database switch. Current Compose persists SQLite + encryption key.
